+        out.operands[3] = (word >> 6) & 0xF;
+        std::snprintf(out.op_str, sizeof(out.op_str), "v%u,v%u,v%u,%u", out.operands[0], out.operands[1], out.operands[2], out.operands[3]);
+        return true;
+    }
 }
