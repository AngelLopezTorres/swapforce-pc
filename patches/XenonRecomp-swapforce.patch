+// ---- binary16 (IEEE 754-2008) <-> binary32, para vpkd3d128 / vupkd3d128 tipo FLOAT16_4 (Skylanders: Swap Force) ----
+// Referencia: Xenia, cpu/backend/x64/x64_seq_vector.cc (PACK/UNPACK FLOAT16_4) y third_party/half (float2half<round_toward_zero>).
+// Trabajan con los bits del float para no depender del entorno de coma flotante (MXCSR).
+inline uint16_t ppc_f32bits_to_f16_rz(uint32_t bits)
+{
+    uint32_t sign = (bits >> 16) & 0x8000u, e = (bits >> 23) & 0xFFu, m = bits & 0x7FFFFFu;
+    if (e == 0xFFu) return uint16_t(sign | 0x7C00u | (m ? (0x0200u | (m >> 13)) : 0u)); // infinito / NaN (silenciado)
+    if (e >= 143u) return uint16_t(sign | 0x7BFFu);                                      // desbordamiento: redondeo a cero -> mayor finito
+    if (e >= 113u) return uint16_t(sign | ((e - 112u) << 10) | (m >> 13));              // normal
+    if (e >= 103u) return uint16_t(sign | (((1u << 23) | m) >> (126u - e)));            // subnormal (truncado)
+    return uint16_t(sign);                                                               // subdesbordamiento -> +-0
+}
+
+inline uint32_t ppc_f16_to_f32bits(uint16_t h)
+{
+    uint32_t sign = (uint32_t(h) & 0x8000u) << 16, e = (h >> 10) & 0x1Fu, m = h & 0x3FFu;
+    if (e == 0x1Fu) return sign | 0x7F800000u | (m ? (0x400000u | (m << 13)) : 0u);     // infinito / NaN (silenciado)
+    if (e != 0u) return sign | ((e + 112u) << 23) | (m << 13);                          // normal
+    if (m == 0u) return sign;                                                            // +-0
+    uint32_t sh = uint32_t(__builtin_clz(m)) - 21u;                                      // subnormal: normalizar (m < 0x400)
+    return sign | ((113u - sh) << 23) | (((m << sh) & 0x3FFu) << 13);
+}
